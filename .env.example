# Copiar a .env y reemplazar todos los valores CHANGE_ME con secretos aleatorios.
# Este archivo contiene placeholders, no credenciales utilizables.
HYS_ENVIRONMENT=development
HYS_DOMAIN=localhost
ACME_EMAIL=admin@example.invalid

POSTGRES_DB=hys
POSTGRES_USER=hys_owner
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_OWNER_PASSWORD
HYS_DB_APP_PASSWORD=CHANGE_ME_RANDOM_APP_PASSWORD
HYS_MIGRATION_DATABASE_URL=postgresql+asyncpg://hys_owner:CHANGE_ME_RANDOM_OWNER_PASSWORD@db:5432/hys
HYS_DATABASE_URL=postgresql+asyncpg://hys_app:CHANGE_ME_RANDOM_APP_PASSWORD@db:5432/hys
HYS_PUBLIC_ORIGIN=https://localhost

S3_ACCESS_KEY=CHANGE_ME_RANDOM_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_RANDOM_S3_SECRET_KEY
S3_BUCKET=hys-private
S3_ENDPOINT=http://seaweedfs:8333

HYS_LOG_LEVEL=INFO
HYS_TRUSTED_HOSTS=localhost,api
HYS_CORS_ORIGINS=
