{
  "name": "@hys/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "api:generate": "openapi-ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lint": "node --test tests/lint/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "typescript-eslint": "8.69.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "16.4.0",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "8.10.2",
    "brace-expansion@<2": "1.1.21",
    "brace-expansion@>=4": "5.0.12"
  }
}
